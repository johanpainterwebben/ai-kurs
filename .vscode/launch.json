{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kör med sparade svar (mock)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "env": { "TNU_MOCK": "1" }
    },
    {
      "name": "Kör mot temperatur.nu (.env)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
