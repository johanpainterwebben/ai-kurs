# Inställningar för pull-deploy. Kopiera till /etc/temperatur-deploy.env på
# servern (chmod 600) och fyll i. Filen innehåller inga hemligheter, men
# NOTIFY_URL kan vara en adress som inte bör spridas.

# Imagen som CI publicerar (gemener), utan tagg.
IMAGE="ghcr.io/<github-konto>/<repo>"

# Taggen som pekar på senaste godkända version.
TAG=main

# Katalogen med docker-compose.yml och appens .env.
APP_DIR="<appkatalog>"

# Vem som får ha signerat imagen: CI-workflowet på main i det här repot.
SIGNER_IDENTITY="https://github.com/<github-konto>/<repo>/.github/workflows/ci.yml@refs/heads/main"

# Hur länge (sekunder) en ny version får på sig att bli "healthy".
HEALTH_TIMEOUT=120

# Valfritt: adress som får ett POST-anrop med texten när något går fel,
# t.ex. en ntfy-kanal. Lämna tom för att bara logga.
NOTIFY_URL=
