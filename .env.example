# Kopiera till .env och fyll i.
# Utan nyckel ska cli vara din e-postadress enligt temperatur.nu:s villkor.
TNU_CLI=din@epost.se
# Hemlig klientnyckel från temperatur.nu (kontakt på https://www.temperatur.nu/info/api/). Lämna tom tills du fått en.
TNU_CLI_KEY=

# Valfritt (standardvärdena visas):
# Hur ofta listan med mätpunkter hämtas från temperatur.nu. Lägsta värde 5m,
# eftersom API:et inte tillåter samma fråga oftare än var femte minut.
# REFRESH_INTERVAL=10m
# Adress som servern lyssnar på. I containern ska den vara :8080.
# ADDR=:8080
